<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="index, follow">
  <link rel="icon" href="data:,">
  <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  {% if site.adsenseClientId %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClientId }}" crossorigin="anonymous"></script>
  {% endif %}
</head>
<body>
  <header class="site-header">
    <a class="brand" href="{{ '/' | url }}">{{ site.title }}</a>
    <nav>
      <a href="{{ '/' | url }}">Home</a>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/contact/' | url }}">Contact</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>As an Amazon Associate, {{ site.title }} earns from qualifying purchases. See our <a href="{{ '/affiliate-disclosure/' | url }}">affiliate disclosure</a>.</p>
    <nav>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/contact/' | url }}">Contact</a>
      <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a>
      <a href="{{ '/affiliate-disclosure/' | url }}">Affiliate Disclosure</a>
      <a href="{{ '/terms/' | url }}">Terms</a>
    </nav>
    <p>&copy; {{ currentYear }} {{ site.title }}</p>
  </footer>
</body>
</html>
