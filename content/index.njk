---
layout: base.njk
title: null
description: null
---
<section class="hero">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
</section>

<section class="post-list">
  <h2>Latest Guides</h2>
  {% for post in collections.posts %}
  <article class="post-card">
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="post-meta">{{ post.data.date | readableDate }}</p>
    <p>{{ post.data.description }}</p>
    <a href="{{ post.url }}">Read the guide &rarr;</a>
  </article>
  {% endfor %}
</section>
